{
  "name": "aseprite-toolkit",
  "description": "aseprite-toolkit",
  "author": "Joost Hobma",
  "license": "MIT",
  "version": "1.1.1",
  "type": "module",
  "homepage": "https://github.com/jossafossa/aseprite-toolkit",
  "issues": "https://github.com/jossafossa/aseprite-toolkit/issues",
  "keywords": [
    "keyboard",
    "shortcut",
    "listener"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jossafossa/aseprite-toolkit.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "prepare": "husky",
    "check": "pnpm run typecheck && pnpm run build",
    "prepublishOnly": "pnpm run check",
    "release": "pnpm publish",
    "tsc": "tsc"
  },
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-istanbul": "^2.1.5",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^15.11.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prettier": "3.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5"
  },
  "volta": {
    "node": "20.18.1",
    "pnpm": "9.14.2"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "sharp": "^0.33.5"
  }
}
